#!/bin/sh
# run_imoab_tests.sh — generated by configure from run_imoab_tests.sh.in
# Runs the iMOAB BfB/tolerance regression harness.
# Usage:  run_imoab_tests.sh [config-name]
#   With no argument: run all 14 configs sequentially.
#   With one argument: run only that config.

MOAB_BUILD="@abs_top_builddir@"
MOAB_MESH_DIR="@abs_top_srcdir@/MeshFiles"
MPIRUN="@MPIEXEC@"
MBCMPFILES="@abs_top_builddir@/tools/mbcmpfiles"
RUNNER_DIR="@abs_top_srcdir@/test/parallel/regression"

export MOAB_BUILD MOAB_MESH_DIR MPIRUN MBCMPFILES

IMOAB_CONFIGS="dualmap_caas spmv_bfb coupler coupler_bfb coupler_bilin coupler_twohop map_target read_compute_map map_r2l phatm_ocn_coupler domain_culling scrip setwithgid ptest2"

echo "=== iMOAB regression harness ==="
echo "  MOAB_BUILD    = $MOAB_BUILD"
echo "  MOAB_MESH_DIR = $MOAB_MESH_DIR"
echo "  MPIRUN        = $MPIRUN"
echo "  MBCMPFILES    = $MBCMPFILES"
echo ""

if [ $# -ge 1 ]; then
    exec "$RUNNER_DIR/imoab_test_runner.sh" "$1"
fi

for cfg in $IMOAB_CONFIGS; do
    echo "--- $cfg ---"
    "$RUNNER_DIR/imoab_test_runner.sh" "$cfg" || exit 1
done
