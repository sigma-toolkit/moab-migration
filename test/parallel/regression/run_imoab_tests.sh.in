#!/bin/sh
# run_imoab_tests.sh — generated by configure from run_imoab_tests.sh.in
# Runs the iMOAB BfB/tolerance regression harness.
#
# Usage:
#   run_imoab_tests.sh [<dispatcher-flag> ...] [<config-name>]
#
# Positional argument (optional):
#   <config-name>    Run only that config (basename of a file in
#                    test/parallel/regression/configs/, without .cfg).
#                    If omitted, all configs in $IMOAB_CONFIGS run sequentially.
#
# Forwarded dispatcher flags (passed verbatim to each per-config invocation):
#   --ranks "N1 N2 ..."   Override DEFAULT_RANKS for the sweep.
#   --workdir <dir>       Use <dir> for intermediate files (implies --keep).
#   --keep                Preserve auto-named workdir.
#   --mbcmp <path>        Override $MBCMPFILES.
#   --tol <value>         Override TOLERANCE (tol-mode configs).
#   --extra <flag=value>  Pass-through to EXTRA_FLAG_1.
#
# Shortcut flags (handled here, not forwarded across configs):
#   --list               List available configs and exit.
#   -h | --help          Show this message and exit.

MOAB_BUILD="@abs_top_builddir@"
MOAB_MESH_DIR="@abs_top_srcdir@/MeshFiles"
MPIRUN="@MPIEXEC@"
MBCMPFILES="@abs_top_builddir@/tools/mbcmpfiles"
RUNNER_DIR="@abs_top_srcdir@/test/parallel/regression"
DISPATCHER="$RUNNER_DIR/imoab_test_runner.sh"

export MOAB_BUILD MOAB_MESH_DIR MPIRUN MBCMPFILES

IMOAB_CONFIGS="dualmap_caas spmv_bfb coupler coupler_bfb coupler_bilin coupler_twohop map_target read_compute_map map_r2l phatm_ocn_coupler domain_culling scrip setwithgid ptest2"

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' >&2; }

# Parse args: separate forwarded flags from optional positional config name.
# Use a shell-quoted accumulator so values containing spaces (e.g. --ranks
# "1 2 4") survive being rebuilt into the dispatcher's argv via `eval set --`.
config=""
new_argv=""
push_argv() {
    q=$(printf '%s\n' "$1" | sed "s/'/'\\\\''/g")
    new_argv="$new_argv '$q'"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --ranks|--workdir|--mbcmp|--tol|--extra)
            if [ $# -lt 2 ]; then
                echo "ERROR: $1 requires a value" >&2; exit 2
            fi
            push_argv "$1"; push_argv "$2"; shift 2 ;;
        --keep)
            push_argv "$1"; shift ;;
        --list|-h|--help)
            exec "$DISPATCHER" "$1" ;;
        --)
            shift
            while [ $# -gt 0 ]; do push_argv "$1"; shift; done ;;
        -*)
            echo "ERROR: unknown option: $1" >&2; usage; exit 2 ;;
        *)
            if [ -n "$config" ]; then
                echo "ERROR: only one config name allowed (got '$config' and '$1')" >&2
                exit 2
            fi
            config="$1"; shift ;;
    esac
done

# Rebuild $@ as the forwarded-flag list.
eval "set -- $new_argv"

echo "=== iMOAB regression harness ==="
echo "  MOAB_BUILD    = $MOAB_BUILD"
echo "  MOAB_MESH_DIR = $MOAB_MESH_DIR"
echo "  MPIRUN        = $MPIRUN"
echo "  MBCMPFILES    = $MBCMPFILES"
if [ $# -gt 0 ]; then
    # Show what's being forwarded so the operator can spot quoting mistakes.
    printf '  FORWARDING    ='; for a in "$@"; do printf ' %s' "$a"; done; echo
fi
echo ""

if [ -n "$config" ]; then
    exec "$DISPATCHER" "$config" "$@"
fi

for cfg in $IMOAB_CONFIGS; do
    echo "--- $cfg ---"
    "$DISPATCHER" "$cfg" "$@" || exit 1
done
